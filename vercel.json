{
    "headers": [
        {
            "source": "/t/:token",
            "headers": [
                { "key": "Cache-Control", "value": "no-store" },
                { "key": "Referrer-Policy", "value": "no-referrer" }
            ]
        }
    ],
    "rewrites": [
        {
            "source": "/l/:token",
            "destination": "https://poputki-backend-9dv6.onrender.com/l/:token"
        },
        {
            "source": "/r/:code",
            "destination": "https://poputki-backend-9dv6.onrender.com/r/:code"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}